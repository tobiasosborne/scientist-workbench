{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@workbench/protocol": ["packages/protocol/src/index.ts"],
      "@workbench/contract": ["packages/contract/src/index.ts"],
      "@workbench/cas-core": ["packages/cas-core/src/index.ts"],
      "@workbench/mod-core": ["packages/mod-core/src/index.ts"],
      "@workbench/json-bridge": ["packages/json-bridge/src/index.ts"],
      "@workbench/sturm-ir": ["packages/sturm-ir/src/index.ts"],
      "@workbench/sturm": ["packages/sturm/src/index.ts"],
      "@workbench/sturm-lib": ["packages/sturm-lib/src/index.ts"],
      "@workbench/linalg-core": ["packages/linalg-core/src/index.ts"],
      "@workbench/quadrature": ["packages/quadrature/src/index.ts"],
      "@workbench/lbfgs-projected": ["packages/lbfgs-projected/src/index.ts"],
      "@workbench/ode-core": ["packages/ode-core/src/index.ts"],
      "@workbench/compose": ["packages/compose/src/index.ts"],
      "@workbench/bigfloat": ["packages/bigfloat/src/index.ts"],
      "@workbench/hypergeometric": ["packages/hypergeometric/src/index.ts"],
      "@workbench/meijer-core": ["packages/meijer-core/src/index.ts"],
      "@workbench/alg-num": ["packages/alg-num/src/index.ts"],
      "@workbench/real-roots": ["packages/real-roots/src/index.ts"],
      "@workbench/solve": ["packages/solve/src/index.ts"],
      "@workbench/poly-factor": ["packages/poly-factor/src/index.ts"],
      "@workbench/groebner": ["packages/groebner/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tools/*/*.ts",
    "scripts/**/*.ts"
  ]
}
